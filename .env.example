# Copy this file to .env.local if you need to customize paths.
#
# For beginners, leave these defaults alone:
# - Run ./Setup Irodori.command once.
# - Run ./Start UI.command.
# - Run ./Start Bridge Lab Only.command.
# - The first voice generation downloads the Irodori model files from Hugging Face.

IRODORI_REPO_DIR=./third_party/Irodori-TTS
IRODORI_LAB_VOICE_MODEL=Aratako/Irodori-TTS-600M-v3-VoiceDesign
IRODORI_FINAL_BASE_CHECKPOINT=Aratako/Irodori-TTS-500M-v3
IRODORI_SPEAKER_BASE_CHECKPOINT=Aratako/Irodori-TTS-500M-v3

# Optional: force CPU when MPS causes issues.
# IRODORI_SPEAKER_DEVICE=cpu

# Optional: use a separate Python/runtime for Speaker Inversion.
# Set these only if the default third_party/Irodori-TTS/.venv cannot import
# pandas/datasets or if you keep the training runtime outside this repository.
# IRODORI_SPEAKER_PYTHON=/absolute/path/to/python3.10
# IRODORI_SPEAKER_PYTHONPATH=/absolute/path/to/Irodori-TTS/.venv/lib/python3.10/site-packages
# IRODORI_SPEAKER_HF_HOME=/absolute/path/to/hf_home

# Optional: if you already downloaded model.safetensors manually, point here instead.
# IRODORI_LAB_VOICE_MODEL=/absolute/path/to/Irodori-TTS-600M-v3-VoiceDesign/model.safetensors
# IRODORI_FINAL_BASE_CHECKPOINT=/absolute/path/to/Irodori-TTS-500M-v3/model.safetensors
